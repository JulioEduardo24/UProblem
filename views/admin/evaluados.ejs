<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Evaluaciones</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px;
            border-radius: 12px;
            margin-bottom: 30px;
        }

        .tabs-container {
            display: flex;
            gap: 8px;
            margin-bottom: 30px;
            border-bottom: 2px solid var(--border-color);
            overflow-x: auto;
        }

        .tab-btn {
            padding: 14px 24px;
            background: none;
            border: none;
            border-bottom: 3px solid transparent;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 500;
            color: var(--text-secondary);
            transition: all 0.3s;
            white-space: nowrap;
        }

        .tab-btn:hover {
            color: var(--primary-color);
        }

        .tab-btn.active {
            color: var(--primary-color);
            border-bottom-color: var(--primary-color);
        }

        .tab-panel {
            display: none;
        }

        .tab-panel.active {
            display: block;
        }

        .dimension-section {
            background: var(--bg-secondary);
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 30px;
            border: 2px solid var(--border-color);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .status-badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .status-completado {
            background: #d4edda;
            color: #155724;
        }

        .status-pendiente {
            background: #fff3cd;
            color: #856404;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 24px 0;
        }

        .stat-card {
            background: var(--bg-primary);
            padding: 20px;
            border-radius: 10px;
            border-left: 4px solid #e74c3c;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .stat-label {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: bold;
            color: var(--text-primary);
        }

        .stat-subtitle {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-top: 6px;
        }

        .hypothesis-box {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
        }

        .chart-wrapper {
            position: relative;
            height: 350px;
            margin: 24px 0;
            background: var(--bg-primary);
            padding: 20px;
            border-radius: 8px;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            background: var(--bg-primary);
            border-radius: 8px;
            overflow: hidden;
        }

        .data-table thead {
            background: var(--primary-color);
            color: white;
        }

        .data-table th,
        .data-table td {
            padding: 14px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
        }

        .data-table tbody tr:hover {
            background: var(--bg-secondary);
        }

        .info-box {
            background: #d1ecf1;
            border-left: 4px solid #17a2b8;
            padding: 16px;
            border-radius: 6px;
            margin: 16px 0;
            color: #0c5460;
        }

        [data-theme="dark"] .info-box {
            background: #1f3942;
            color: #9fcddc;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="navbar-header">
                <h1>Panel de Administración</h1>
                <button class="menu-toggle" id="menuToggle">
                    <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="nav-menu" id="navMenu">
                <a href="/administrator" class="nav-link">Inicio</a>
                <a href="/evaluaciones" class="nav-link active">Evaluaciones</a>
                <button id="themeToggle" class="btn-icon" title="Cambiar tema">
                    <svg class="theme-icon sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <circle cx="12" cy="12" r="5"></circle>
                    </svg>
                    <svg class="theme-icon moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                </button>
                <a href="/auth/logout" class="btn btn-secondary">Salir</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1><%= titulo %></h1>
            <p style="margin: 0; opacity: 0.95;">Análisis de Hipótesis</p>
        </div>

        <!-- Tabs -->
        <div class="tabs-container">
            <button class="tab-btn active" onclick="switchTab(0)">Resumen</button>
            <button class="tab-btn" onclick="switchTab(1)">Dimensión 1: Eficiencia Temporal</button>
            <button class="tab-btn" onclick="switchTab(2)">Dimensión 2: Precisión de categorización</button>
            <button class="tab-btn" onclick="switchTab(3)">Dimensión 3: Control Presupuestario</button>
        </div>

        <!-- TAB 0: RESUMEN -->
        <div class="tab-panel active" id="panel-0">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">Total Participantes</div>
                    <div class="stat-value"><%= pretestD1.metadata?.total_participantes || 0 %></div>
                    <div class="stat-subtitle">Pre-test inicial</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Dimensiones</div>
                    <div class="stat-value">3</div>
                    <div class="stat-subtitle">Variable dependiente</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Fecha Pre-test</div>
                    <div class="stat-value" style="font-size: 1.3rem;">31/03/2026</div>
                    <div class="stat-subtitle">Evaluación manual</div>
                </div>
            </div>

            <!-- Dimensión 1 -->
            <div class="dimension-section">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">Dimensión 1: Eficiencia Temporal</h2>
                        <p style="margin: 8px 0 0 0; color: var(--text-secondary);">
                            Tiempo de registro de gastos personales
                        </p>
                    </div>
                    <span class="status-badge status-completado">✓ Pre-test completado</span>
                </div>

                <div class="hypothesis-box">
                    <h4 style="margin: 0 0 10px 0;">Hipótesis He1:</h4>
                    <p style="margin: 0;">
                        El sistema web <strong>(post-test)</strong> reduce significativamente el tiempo promedio de registro semanal de gastos personales en comparación con el método manual tradicional <strong>(pre-test)</strong>.
                    </p>
                    <p style="margin: 8px 0 0 0; font-size: 0.95rem; opacity: 0.9;">
                        Fórmula: μ<sub>post</sub> &lt; μ<sub>pre</sub>
                    </p>
                </div>

                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-label">📝 Pre-test (Manual)</div>
                        <div class="stat-value" style="color: #e74c3c;">
                            <%= pretestD1.estadisticas?.tiempo_por_transaccion_promedio?.toFixed(2) || 0 %>s
                        </div>
                        <div class="stat-subtitle">Promedio por transacción</div>
                    </div>
                    <div class="stat-card" style="border-left-color: #95a5a6;">
                        <div class="stat-label">💻 Post-test (Sistema)</div>
                        <div class="stat-value" style="color: #95a5a6;">Pendiente</div>
                        <div class="stat-subtitle">Por definir</div>
                    </div>
                </div>

                <button class="btn btn-primary" onclick="switchTab(1)" style="margin-top: 16px;">
                    Ver datos completos →
                </button>
            </div>

            <!-- Dimensión 2 -->
            <div class="dimension-section">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">Dimensión 2: Precisión de categorización</h2>
                        <p style="margin: 8px 0 0 0; color: var(--text-secondary);">
                            Tasa de error de categorización 
                        </p>
                    </div>
                    <span class="status-badge status-pendiente">⏳ Pendiente</span>
                </div>

                <div class="info-box">
                    <p style="margin: 0;">
                        <strong>Instrumento:</strong> Cuestionario de Utilidad de Recomendaciones (CUR) a aplicar en el post-test.
                    </p>
                </div>
            </div>

            <!-- Dimensión 3 -->
            <div class="dimension-section">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">Dimensión 3: Control Presupuestario</h2>
                        <p style="margin: 8px 0 0 0; color: var(--text-secondary);">
                            Varianza presupuestaria
                        </p>
                    </div>
                    <span class="status-badge status-pendiente">⏳ Por definir</span>
                </div>

                <div class="info-box">
                    <p style="margin: 0;">
                        Metodología de medición y recolección de datos en proceso de definición.
                    </p>
                </div>
            </div>
        </div>

        <!-- TAB 1: DIMENSIÓN 1 COMPLETA -->
        <div class="tab-panel" id="panel-1">
            <div class="dimension-section">
                <div class="section-header">
                    <h2 class="section-title">Dimensión 1: Eficiencia Temporal</h2>
                    <a href="/evaluaciones/exportar/1" class="btn btn-outline">⬇ Exportar CSV</a>
                </div>

                <!-- Información del pre-test -->
                <div style="background: var(--bg-primary); padding: 20px; border-radius: 8px; margin-bottom: 24px;">
                    <h3>Información del Pre-test</h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-top: 16px;">
                        <div>
                            <strong>Fecha:</strong> <%= pretestD1.metadata?.fecha_evaluacion || '-' %>
                        </div>
                        <div>
                            <strong>Método:</strong> <%= pretestD1.metadata?.metodo || '-' %>
                        </div>
                        <div>
                            <strong>Participantes:</strong> <%= pretestD1.metadata?.total_participantes || 0 %>
                        </div>
                        <div>
                            <strong>Transacciones/participante:</strong> <%= pretestD1.metadata?.transacciones_por_participante || 0 %>
                        </div>
                    </div>
                </div>

                <!-- Estadísticas -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-label">Tiempo Promedio Total</div>
                        <div class="stat-value"><%= pretestD1.estadisticas?.tiempo_total_promedio?.toFixed(2) || 0 %>s</div>
                        <div class="stat-subtitle">Por participante (20 transacciones)</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Tiempo Promedio por Transacción</div>
                        <div class="stat-value"><%= pretestD1.estadisticas?.tiempo_por_transaccion_promedio?.toFixed(2) || 0 %>s</div>
                        <div class="stat-subtitle">Indicador principal</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Rango de Tiempos</div>
                        <div class="stat-value" style="font-size: 1.4rem;">
                            <%= pretestD1.estadisticas?.tiempo_minimo || 0 %>s - <%= pretestD1.estadisticas?.tiempo_maximo || 0 %>s
                        </div>
                        <div class="stat-subtitle">Mínimo - Máximo</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Desviación Estándar</div>
                        <div class="stat-value"><%= pretestD1.estadisticas?.desviacion_estandar?.toFixed(2) || 0 %>s</div>
                        <div class="stat-subtitle">Dispersión de datos</div>
                    </div>
                </div>

                <!-- Gráfico -->
                <div class="chart-wrapper">
                    <canvas id="chartPretest"></canvas>
                </div>

                <!-- Tabla de participantes -->
                <h3 style="margin: 30px 0 16px 0;">Datos Detallados por Participante</h3>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Participante</th>
                            <th>Fecha</th>
                            <th>Tiempo Total (s)</th>
                            <th>N° Transacc.</th>
                            <th>T. Promedio (s)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% pretestD1.participantes?.forEach(p => { %>
                        <tr>
                            <td><%= p.id %></td>
                            <td><strong><%= p.nombre %></strong></td>
                            <td><%= p.fecha %></td>
                            <td><%= p.tiempo_total_segundos %></td>
                            <td><%= p.numero_transacciones %></td>
                            <td><strong><%= p.tiempo_promedio_segundos %></strong></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 2: DIMENSIÓN 2 -->
        <div class="tab-panel" id="panel-2">
            <div class="dimension-section">
                <h2 class="section-title">Dimensión 2: Precisión de categorización</h2>
                <div class="info-box" style="margin-top: 24px;">
                    <h4 style="margin: 0 0 12px 0; color: #17a2b8;">Ficha de observación pendiente</h4>
                    <p style="margin: 0;">
                        Los datos de esta dimensión se obtendrán mediante la Ficha de Observación N° 2 de Precisión de Categorización.
                    </p>
                </div>
            </div>
        </div>

        <!-- TAB 3: DIMENSIÓN 3 -->
        <div class="tab-panel" id="panel-3">
            <div class="dimension-section">
                <h2 class="section-title">Dimensión 3: Control Presupuestario</h2>
                <div class="info-box" style="margin-top: 24px;">
                    <h4 style="margin: 0 0 12px 0; color: #17a2b8;">Ficha de observación pendiente</h4>
                    <p style="margin: 0;">
                        Los datos de esta dimensión se obtendrán mediante la Ficha de Observación N° 3 de Control Presupuestario.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Cambiar tabs
        function switchTab(index) {
            document.querySelectorAll('.tab-btn').forEach((btn, i) => {
                btn.classList.toggle('active', i === index);
            });
            document.querySelectorAll('.tab-panel').forEach((panel, i) => {
                panel.classList.toggle('active', i === index);
            });
        }

        // Crear gráfico de pre-test
        window.addEventListener('DOMContentLoaded', () => {
            const ctx = document.getElementById('chartPretest');
            if (!ctx) return;

            const participantes = <%- JSON.stringify(pretestD1.participantes || []) %>;
            const nombres = participantes.map(p => p.nombre.split(' ')[0]);
            const tiempos = participantes.map(p => p.tiempo_promedio_segundos);

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: nombres,
                    datasets: [{
                        label: 'Tiempo Promedio Pre-test (segundos)',
                        data: tiempos,
                        backgroundColor: 'rgba(231, 76, 60, 0.6)',
                        borderColor: 'rgba(231, 76, 60, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true
                        },
                        title: {
                            display: true,
                            text: 'Distribución de Tiempos - Pre-test (31/03/2026)'
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Segundos'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Participantes'
                            }
                        }
                    }
                }
            });
        });
    </script>

    <script src="/js/theme.js"></script>
    <script src="/js/navbar.js"></script>
</body>
</html>
