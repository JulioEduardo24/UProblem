<!DOCTYPE html>
<html lang="es" data-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis Gastos - UProblem</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <nav class="navbar">
        <div class="container">
            <div class="navbar-header">
                <h1>UProblem</h1>
                <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
                    <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                    <svg class="close-icon" style="display: none;" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="nav-menu" id="navMenu">
                <a href="/dashboard" class="nav-link">Dashboard</a>
                <a href="/gastos" class="nav-link active">Gastos</a>
                <a href="/presupuestos" class="nav-link">Presupuestos</a>
                <a href="/recomendaciones" class="nav-link">Recomendaciones</a>
                <a href="/perfil" class="nav-link">Perfil</a>
                <button id="themeToggle" class="btn-icon" title="Cambiar tema">
                    <svg class="theme-icon sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                    <svg class="theme-icon moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                </button>
                <a href="/auth/logout" class="btn btn-secondary">Salir</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <div>
                <h2>Mis Gastos</h2>
                <p class="page-subtitle">Gestiona y visualiza tus gastos personales</p>
            </div>
            <a href="/gastos/nuevo" class="btn btn-primary">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Nuevo Gasto
            </a>
        </div>

        <% if (typeof req !=='undefined' && typeof req.query !=='undefined' ) { %>
            <% if (req.query.success==='created' ) { %>
                <div class="alert alert-success">✓ Gasto registrado exitosamente</div>
                <% } else if (req.query.success==='updated' ) { %>
                    <div class="alert alert-success">✓ Gasto actualizado exitosamente</div>
                    <% } else if (req.query.success==='deleted' ) { %>
                        <div class="alert alert-success">✓ Gasto eliminado exitosamente</div>
                        <% } else if (req.query.error==='invalid' ) { %>
                            <div class="alert alert-error">✗ Datos inválidos</div>
                            <% } %>
                                <% } %>

                                    <div class="filters-card">
                                        <form class="filters-form" method="GET" action="/gastos">
                                            <div class="filter-group">
                                                <label for="categoria">CATEGORÍA</label>
                                                <select name="categoria" id="categoria">
                                                    <option value="">Todas</option>
                                                    <% categorias.forEach(cat=> { %>
                                                        <option value="<%= cat %>" <%=categoria===cat ? 'selected' : ''
                                                            %>><%= cat %>
                                                        </option>
                                                        <% }); %>
                                                </select>
                                            </div>

                                            <div class="filter-group">
                                                <label for="desde">DESDE</label>
                                                <input type="date" name="desde" id="desde" value="<%= desde || '' %>">
                                            </div>

                                            <div class="filter-group">
                                                <label for="hasta">HASTA</label>
                                                <input type="date" name="hasta" id="hasta" value="<%= hasta || '' %>">
                                            </div>

                                            <div style="display: flex; gap: 8px;">
                                                <button type="submit" class="btn btn-primary">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2">
                                                        <circle cx="11" cy="11" r="8"></circle>
                                                        <path d="m21 21-4.35-4.35"></path>
                                                    </svg>
                                                    Filtrar
                                                </button>
                                                <a href="/gastos" class="btn btn-outline">Limpiar</a>
                                            </div>
                                        </form>
                                    </div>

                                    <% if (gastos.length> 0) { %>
                                        <div class="export-section">
                                            <div class="export-header">
                                                <div>
                                                    <h3>Exportar Reporte</h3>
                                                    <p>Descarga tus gastos en PDF o Excel</p>
                                                </div>
                                                <div class="export-buttons">
                                                    <button onclick="exportarPDF()" class="btn-export btn-export-pdf">
                                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                                            stroke="currentColor" stroke-width="2">
                                                            <path
                                                                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z">
                                                            </path>
                                                            <polyline points="14 2 14 8 20 8"></polyline>
                                                            <line x1="16" y1="13" x2="8" y2="13"></line>
                                                            <line x1="16" y1="17" x2="8" y2="17"></line>
                                                            <polyline points="10 9 9 9 8 9"></polyline>
                                                        </svg>
                                                        Exportar PDF
                                                    </button>
                                                    <button onclick="exportarExcel()"
                                                        class="btn-export btn-export-excel">
                                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                                            stroke="currentColor" stroke-width="2">
                                                            <path
                                                                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z">
                                                            </path>
                                                            <polyline points="14 2 14 8 20 8"></polyline>
                                                            <line x1="12" y1="18" x2="12" y2="12"></line>
                                                            <line x1="9" y1="15" x2="15" y2="15"></line>
                                                        </svg>
                                                        Exportar Excel
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>

                                            <p class="resultados-count">
                                                Mostrando <%= gastos.length %> gasto<%= gastos.length !==1 ? 's' : '' %>
                                                        <% if (typeof totalMensual !=='undefined' ) { %>
                                                            - Total: <strong>S/ <%= totalMensual.toFixed(2) %></strong>
                                                            <% } %>
                                            </p>

                                            <% if (gastos.length> 0) { %>
                                                <div class="gastos-list">
                                                    <% gastos.forEach(gasto=> { %>
                                                        <div class="gasto-card">
                                                            <div class="gasto-header">
                                                                <div class="gasto-info">
                                                                    <h3 class="gasto-descripcion">
                                                                        <%= gasto.descripcion %>
                                                                    </h3>
                                                                    <div
                                                                        style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                                                                        <span
                                                                            class="gasto-categoria categoria-<%= gasto.categoria.toLowerCase().replace(/\s+/g, '-') %>">
                                                                            <%= gasto.categoria %>
                                                                        </span>
                                                                        <% if (gasto.categoria_manual===false) { %>
                                                                            <span class="badge-auto">
                                                                                <svg width="12" height="12"
                                                                                    viewBox="0 0 24 24" fill="none"
                                                                                    stroke="currentColor"
                                                                                    stroke-width="2">
                                                                                    <polyline points="20 6 9 17 4 12">
                                                                                    </polyline>
                                                                                </svg>
                                                                                Automático
                                                                            </span>
                                                                            <% } %>
                                                                    </div>
                                                                </div>
                                                                <span class="gasto-monto">S/ <%=
                                                                        parseFloat(gasto.monto).toFixed(2) %></span>
                                                            </div>

                                                            <div class="gasto-details">
                                                                <div class="gasto-fecha">
                                                                    <svg width="16" height="16" viewBox="0 0 24 24"
                                                                        fill="none" stroke="currentColor"
                                                                        stroke-width="2">
                                                                        <rect x="3" y="4" width="18" height="18" rx="2"
                                                                            ry="2"></rect>
                                                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                                                    </svg>
                                                                    <%= new
                                                                        Date(gasto.fecha).toLocaleDateString('es-PE', {
                                                                        day: 'numeric' , month: 'long' , year: 'numeric'
                                                                        }) %>
                                                                </div>
                                                                <% if (gasto.notas) { %>
                                                                    <div class="gasto-notas">
                                                                        <svg width="16" height="16" viewBox="0 0 24 24"
                                                                            fill="none" stroke="currentColor"
                                                                            stroke-width="2">
                                                                            <path
                                                                                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z">
                                                                            </path>
                                                                            <polyline points="14 2 14 8 20 8">
                                                                            </polyline>
                                                                            <line x1="16" y1="13" x2="8" y2="13"></line>
                                                                            <line x1="16" y1="17" x2="8" y2="17"></line>
                                                                            <polyline points="10 9 9 9 8 9"></polyline>
                                                                        </svg>
                                                                        <%= gasto.notas %>
                                                                    </div>
                                                                    <% } %>
                                                            </div>

                                                            <div class="gasto-actions">
                                                                <a href="/gastos/editar/<%= gasto.id %>"
                                                                    class="btn-action btn-edit">
                                                                    <svg width="16" height="16" viewBox="0 0 24 24"
                                                                        fill="none" stroke="currentColor"
                                                                        stroke-width="2">
                                                                        <path
                                                                            d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                                                        </path>
                                                                        <path
                                                                            d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                                                        </path>
                                                                    </svg>
                                                                    Editar
                                                                </a>
                                                                <form method="POST"
                                                                    action="/gastos/eliminar/<%= gasto.id %>"
                                                                    style="display: inline;"
                                                                    onsubmit="return confirm('¿Estás seguro de que quieres eliminar este gasto?')">
                                                                    <button type="submit" class="btn-action btn-delete">
                                                                        <svg width="16" height="16" viewBox="0 0 24 24"
                                                                            fill="none" stroke="currentColor"
                                                                            stroke-width="2">
                                                                            <polyline points="3 6 5 6 21 6"></polyline>
                                                                            <path
                                                                                d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                                            </path>
                                                                        </svg>
                                                                        Eliminar
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                        <% }); %>
                                                </div>
                                                <% } else { %>
                                                    <div class="empty-state">
                                                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none"
                                                            stroke="currentColor" stroke-width="1.5">
                                                            <circle cx="12" cy="12" r="10"></circle>
                                                            <line x1="12" y1="8" x2="12" y2="12"></line>
                                                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                                        </svg>
                                                        <h3>No hay gastos registrados</h3>
                                                        <p>Comienza agregando tu primer gasto para empezar a controlar
                                                            tus finanzas</p>
                                                        <a href="/gastos/nuevo" class="btn btn-primary">Registrar Primer
                                                            Gasto</a>
                                                    </div>
                                                    <% } %>
    </div>

    <script src="/js/theme.js"></script>
    <script src="/js/navbar.js"></script>
    <script>
        function exportarPDF() {
            const params = new URLSearchParams(window.location.search);
            const url = `/gastos/exportar/pdf?${params.toString()}`;

            // Mostrar indicador de descarga
            const btn = event.target.closest('button');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Generando PDF...
            `;

            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        return response.json().then(data => {
                            throw new Error(data.message || 'Error al generar PDF');
                        });
                    }
                    return response.blob();
                })
                .then(blob => {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    const fecha = new Date().toISOString().split('T')[0];
                    a.download = `Gastos_${fecha}.pdf`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);

                    btn.disabled = false;
                    btn.innerHTML = originalText;
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert(error.message || 'Error al generar el PDF. Por favor, intenta de nuevo.');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                });
        }

        function exportarExcel() {
            const params = new URLSearchParams(window.location.search);
            const url = `/gastos/exportar/excel?${params.toString()}`;

            // Mostrar indicador de descarga
            const btn = event.target.closest('button');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Generando Excel...
            `;

            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        return response.json().then(data => {
                            throw new Error(data.message || 'Error al generar Excel');
                        });
                    }
                    return response.blob();
                })
                .then(blob => {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    const fecha = new Date().toISOString().split('T')[0];
                    a.download = `Gastos_${fecha}.xlsx`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);

                    btn.disabled = false;
                    btn.innerHTML = originalText;
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert(error.message || 'Error al generar el Excel. Por favor, intenta de nuevo.');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                });
        }
    </script>
</body>

</html>